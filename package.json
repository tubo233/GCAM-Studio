{
  "name": "gcam-china-studio",
  "version": "0.1.3",
  "private": true,
  "description": "GCAM-China Studio - scenario and data workbench for GCAM-China v8",
  "main": "desktop/main.js",
  "scripts": {
    "dev:web": "vite --config frontend/vite.config.ts",
    "dev:api": "runtime\\venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8765 --reload",
    "dev:electron": "cross-env GCAM_STUDIO_DEV=1 electron .",
    "dev": "concurrently -k -n API,WEB,APP -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"wait-on tcp:8765 tcp:5173 && npm:dev:electron\"",
    "build:web": "node node_modules/typescript/bin/tsc --noEmit -p frontend/tsconfig.json && node node_modules/vite/bin/vite.js build --config frontend/vite.config.ts && node tools/package-web.cjs",
    "build:backend": "runtime\\venv\\Scripts\\pyinstaller.exe --noconfirm --distpath build/backend-dist --workpath build/pyinstaller-work build/backend.spec",
    "build:desktop": "electron-builder --win",
    "build": "npm run build:web && npm run build:backend && npm run build:desktop",
    "test:backend": "runtime\\venv\\Scripts\\python.exe -m pytest backend/tests -q"
  },
  "build": {
    "appId": "com.gcamchina.studio",
    "productName": "GCAM-China Studio",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "web"
      },
      {
        "from": "build/backend-dist/gcam-studio-backend",
        "to": "backend"
      },
      {
        "from": "runtime/r-lib",
        "to": "runtime/r-lib"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "GCAM-China-Studio-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "GCAM-China-Studio-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "GCAM-China-Studio-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^9.0.0",
    "@ant-design/icons": "^6.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.13.0",
    "antd": "^5.28.0",
    "axios": "^1.13.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "monaco-editor": "^0.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  }
}
